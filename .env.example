# Umgebung: development | production
NODE_ENV=production
PORT=3000
# Öffentliche Adresse der Seite (für Feeds, Sitemap, Links)
BASE_URL=https://permanent-blog.de
# Langer zufälliger Wert, z. B. erzeugt mit:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Wenn die App hinter einem Reverse-Proxy (nginx, Caddy, Traefik) läuft: Anzahl der Proxys, meist 1
TRUST_PROXY=1
# Speicherort für Datenbank und Uploads
DATA_DIR=./data
