<%- include('partials/head') %>
<article class="article">
  <header class="wrap-narrow article-head">
    <p class="kicker">
      <% if (post.section_name) { %><a href="/rubrik/<%= post.section_slug %>"><%= post.section_name %></a><% } %>
      <% if (post.kind === 'link') { %><span class="kicker-ext">Empfehlung</span><% } %>
      <% if (post.kind === 'gallery') { %><span class="kicker-ext">Fotos</span><% } %>
    </p>
    <h1><%= post.title %></h1>
    <% if (post.excerpt) { %><p class="lede"><%= post.excerpt %></p><% } %>
    <div class="byline">
      <% if (post.author_avatar) { %><img class="avatar" src="<%= h.img(post.author_avatar, 'sm') %>" alt=""><% } %>
      <div>
        <a href="/autor/<%= post.author_slug %>"><strong><%= post.author_name %></strong></a><br>
        <span class="muted"><span class="lagernr">Nº <%= String(post.id).padStart(4, '0') %></span> · <time datetime="<%= h.isoDate(post.published_at) %>"><%= h.formatDate(post.published_at) %></time>
        <% if (post.kind === 'article') { %> · <%= h.readingTime(post.body_md) %> Min. Lesezeit<% } %></span>
      </div>
    </div>
  </header>

  <% if (post.cover_file) { %>
  <figure class="wrap cover">
    <img src="<%= h.img(post.cover_file) %>" srcset="<%= h.srcset(post.cover_file) %>" sizes="(max-width: 1100px) 100vw, 1100px" alt="<%= post.cover_alt %>">
    <% if (post.cover_alt) { %><figcaption><%= post.cover_alt %></figcaption><% } %>
  </figure>
  <% } %>

  <div class="wrap-narrow">
    <% if (post.link_url) { %>
    <a class="linkcard" href="<%= post.link_url %>" target="_blank" rel="noopener noreferrer nofollow">
      <% if (post.link_image_file) { %><img src="<%= h.img(post.link_image_file, 'sm') %>" alt=""><% } %>
      <span class="linkcard-body">
        <span class="kicker"><%= post.link_source || h.hostOf(post.link_url) %> ↗</span>
        <strong><%= post.link_title || post.link_url %></strong>
        <% if (post.link_description) { %><span class="muted"><%= post.link_description %></span><% } %>
      </span>
    </a>
    <% } %>

    <div class="prose"><%- post.body_html %></div>
  </div>

  <% if (images.length) { %>
  <section class="wrap gallery" aria-label="Bildergalerie">
    <% images.forEach(img => { %>
      <figure>
        <a href="<%= h.img(img.file) %>" data-lightbox data-caption="<%= img.caption %>">
          <img src="<%= h.img(img.file, 'sm') %>" alt="<%= img.alt || img.caption %>" loading="lazy" decoding="async">
        </a>
        <% if (img.caption) { %><figcaption><%= img.caption %></figcaption><% } %>
      </figure>
    <% }) %>
  </section>
  <% } %>

  <footer class="wrap-narrow article-foot">
    <% if (post.link_url) { %><a class="btn" href="<%= post.link_url %>" target="_blank" rel="noopener noreferrer nofollow">Originalartikel lesen ↗</a><% } %>
  </footer>
</article>

<% if (related.length) { %>
<section class="wrap block">
  <header class="block-head"><h2>Mehr aus <%= post.section_name %></h2></header>
  <div class="grid grid-3"><% related.forEach(p => { %><%- include('partials/post-card', { post: p, hideSection: true }) %><% }) %></div>
</section>
<% } %>
<%- include('partials/foot') %>
