<%- include('_head') %>
<header class="admin-head">
  <h1><%= title %></h1>
  <a class="btn btn-ghost" href="/<%= page.slug %>" target="_blank" rel="noopener">Ansehen ↗</a>
</header>
<% if (saved) { %><p class="alert alert-ok">Gespeichert.</p><% } %>
<form class="form" method="post" action="/admin/seiten/<%= page.slug %>">
  <input type="hidden" name="_csrf" value="<%= csrf() %>">
  <label>Überschrift<input type="text" name="title" value="<%= page.title %>" maxlength="120" required></label>
  <%- include('_editor', { name: 'body_md', value: page.body_md, rows: 28 }) %>
  <p><button class="btn" type="submit">Speichern</button></p>
</form>
<%- include('_foot') %>
